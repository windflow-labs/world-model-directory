{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "World Model Directory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "updatedAt",
    "methodology",
    "providers",
    "models"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date"
    },
    "methodology": {
      "type": "string",
      "minLength": 1
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "url",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "category",
          "controls",
          "weights",
          "weightsUrl",
          "weightLicense",
          "commercial",
          "licenseNote",
          "realtime",
          "measurement",
          "sources",
          "tryAt",
          "checkedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "Driving",
              "Games",
              "Navigation",
              "Physical simulation",
              "Robotics",
              "Spatial worlds",
              "Video interaction"
            ]
          },
          "controls": {
            "type": "string",
            "minLength": 1
          },
          "weights": {
            "enum": [
              "Available",
              "Not published in cited source",
              "Unverified"
            ]
          },
          "weightsUrl": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              },
              {
                "type": "null"
              }
            ]
          },
          "weightLicense": {
            "type": "string",
            "minLength": 1
          },
          "commercial": {
            "enum": [
              "Conflicting sources",
              "Custom terms",
              "Non-commercial",
              "Permissive license declared",
              "Service terms",
              "Unverified"
            ]
          },
          "licenseNote": {
            "type": "string",
            "minLength": 1
          },
          "realtime": {
            "enum": [
              "Author claim",
              "Not real-time",
              "Unverified"
            ]
          },
          "measurement": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "label",
                "url"
              ],
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://"
                }
              }
            }
          },
          "tryAt": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "url",
                "note"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://"
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "checkedAt": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  }
}
